# ── Required ──────────────────────────────────────────────────────────────────

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────

# Overridden by docker-compose — only needed for local dev outside Docker
DATABASE_URL=postgresql+asyncpg://gatekeeper:gatekeeper_dev@localhost:5433/gatekeeperai
DB_PASSWORD=gatekeeper_dev

# ── Redis ─────────────────────────────────────────────────────────────────────

# Overridden by docker-compose — only needed for local dev outside Docker
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────

ENVIRONMENT=production
APP_BASE_URL=https://your-domain.com

# URL browsers use to reach the API (must be publicly accessible)
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# ── Security ──────────────────────────────────────────────────────────────────

# Shared secret between git hook and the API
HOOK_SECRET=

# ── Email (optional) ──────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_USE_TLS=true
APPROVER_EMAILS=

# ── Log forwarding (optional) ─────────────────────────────────────────────────
# Configure any combination of sinks. Leave blank to disable.

# Generic HTTP / Splunk HEC / Datadog Logs API
# LOG_FORWARD_WEBHOOK_URL=https://http-intake.logs.datadoghq.com/api/v2/logs

# Syslog (Splunk, Graylog, rsyslog, syslog-ng)
# LOG_FORWARD_SYSLOG_HOST=syslog.your-company.com
# LOG_FORWARD_SYSLOG_PORT=514
# LOG_FORWARD_SYSLOG_PROTOCOL=UDP   # or TCP

# Grafana Loki
# LOG_FORWARD_LOKI_URL=http://loki:3100/loki/api/v1/push

# ── Kubernetes / EKS (optional — only needed when DEPLOY_BACKEND=kubernetes) ───

# DEPLOY_BACKEND=kubernetes
# AWS_REGION=us-west-2
# ECR_REGISTRY=123456789.dkr.ecr.us-west-2.amazonaws.com
# BUILD_CONTEXT_BUCKET=my-org-gatekeeper-build-contexts
# K8S_APPS_NAMESPACE=gatekeeperai-apps
# K8S_BUILDS_NAMESPACE=gatekeeperai-builds

# AWS CloudWatch Logs
# LOG_FORWARD_CLOUDWATCH_LOG_GROUP=/gatekeeperai/audit
# LOG_FORWARD_CLOUDWATCH_LOG_STREAM=gatekeeperai
# LOG_FORWARD_CLOUDWATCH_REGION=us-east-1
# LOG_FORWARD_CLOUDWATCH_ACCESS_KEY=
# LOG_FORWARD_CLOUDWATCH_SECRET_KEY=
